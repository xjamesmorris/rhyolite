{
  "schemaVersion": 1,
  "common": [
    {
      "path": [
        "SchemaVersion"
      ],
      "required": true,
      "minimum": 1,
      "maximum": 1
    },
    {
      "path": [
        "Sequence"
      ],
      "required": true,
      "minimum": 1,
      "maximumRef": "eventCount"
    }
  ],
  "events": {
    "broker_started": {
      "label": "research broker-start event",
      "fields": [
        {
          "path": [
            "PolicySchemaVersion"
          ],
          "required": true,
          "minimumRef": "expectedPolicySchema",
          "maximumRef": "expectedPolicySchema"
        }
      ]
    },
    "workflow_order_rejected": {
      "label": "research workflow rejection event",
      "fields": [
        {
          "path": [
            "CapabilityInspectionSequence"
          ],
          "required": true,
          "nullable": true,
          "minimum": 1,
          "maximumRef": "priorSequence"
        },
        {
          "path": [
            "LatestSuccessfulRetrievalSequence"
          ],
          "required": true,
          "nullable": true,
          "minimum": 1,
          "maximumRef": "priorSequence"
        },
        {
          "path": [
            "LatestNetworkSummaryObservationSequence"
          ],
          "required": true,
          "nullable": true,
          "minimum": 1,
          "maximumRef": "priorSequence"
        }
      ]
    },
    "public_retrieval_succeeded": {
      "label": "research retrieval event",
