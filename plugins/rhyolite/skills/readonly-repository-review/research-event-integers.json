          ],
          "required": true,
          "minimum": 200,
          "maximum": 299
        }
      ]
    },
    "cookie_send_rejected": {
      "label": "research cookie-send rejection event",
      "fields": []
    },
    "cookie_sent": {
      "label": "research cookie-send event",
      "fields": []
    },
    "cookie_observed": {
      "label": "research cookie observation event",
      "fields": []
