    "unsupported_body_stored": {
      "label": "research unsupported-body event",
      "fields": [
        {
          "path": [
            "Bytes"
          ],
          "required": true,
          "minimum": 0,
          "maximumRef": "maxWireBytes"
        }
      ]
    },
    "request_failed": {
      "label": "research request failure event",
      "fields": [
        {
          "path": [
            "Details",
            "budget"
          ],
          "minimumRef": "requestBudget",
          "maximumRef": "requestBudget",
          "requiredForCodes": [
            "request_budget_exhausted"
          ]
        },
        {
          "path": [
            "Details",
            "port"
          ],
          "minimum": 1,
          "maximum": 65535,
          "requiredForCodes": [
            "tls_port_forbidden"
          ]
        },
        {
          "path": [
            "Details",
            "status"
          ],
          "minimum": 100,
          "maximum": 599,
          "requiredForCodes": [
            "access_policy_denial",
            "rate_limited",
            "http_status"
          ]
        },
        {
          "path": [
            "Details",
            "headerBytes"
          ],
          "minimumRef": "headerBytesExceeded",
          "maximumRef": "maxObservedHeaderBytes",
          "requiredForCodes": [
            "headers_too_large"
          ]
        },
        {
          "path": [
            "Details",
            "limitBytes"
          ],
          "minimumRef": "maxWireBytes",
          "maximumRef": "maxWireBytes",
          "requiredForCodes": [
            "body_too_large"
          ]
        },
        {
          "path": [
            "Details",
            "verifyCode"
          ],
          "nullable": true,
          "minimum": 0,
          "maximum": 2147483647,
          "requiredForCodes": [
            "tls_verification_failed"
          ]
        },
        {
          "path": [
            "Details",
            "diagnosticHandshake",
            "Certificate",
            "CipherBits"
          ],
          "nullable": true,
          "minimum": 1,
          "maximum": 65535,
          "allowedForCodes": [
            "tls_verification_failed"
          ]
        },
        {
          "path": [
            "Details",
            "line"
          ],
          "minimum": 1,
          "maximumRef": "maxBodyPosition",
          "requiredForCodes": [
            "malformed_json"
          ]
        },
        {
          "path": [
            "Details",
            "column"
          ],
          "minimum": 1,
          "maximumRef": "maxBodyPosition",
          "requiredForCodes": [
            "malformed_json"
          ]
        },
        {
          "path": [
            "Details",
            "position",
            0
          ],
          "minimum": 1,
          "maximumRef": "maxBodyPosition",
          "requiredForCodes": [
            "malformed_xml"
          ]
        },
        {
          "path": [
            "Details",
            "position",
            1
          ],
          "minimum": 0,
          "maximumRef": "maxBodyPosition",
          "requiredForCodes": [
            "malformed_xml"
          ]
        },
        {
          "path": [
            "Details",
            "bytes"
          ],
          "minimum": 0,
          "maximumRef": "maxWireBytes",
          "requiredForCodes": [
            "unsupported_format"
          ]
        }
      ]
    },
    "dns_resolution": {
      "label": "research DNS event",
      "fields": [
        {
          "path": [
            "Port"
          ],
          "required": true,
          "minimum": 1,
          "maximum": 65535
        }
      ]
    },
    "tls_handshake": {
      "label": "research TLS event",
      "fields": [
        {
          "path": [
            "Tls",
            "CipherBits"
          ],
          "nullable": true,
          "minimum": 1,
          "maximum": 65535
        }
      ]
    },
    "http_response": {
      "label": "research HTTP response event",
      "fields": [
        {
          "path": [
            "Status"
          ],
          "required": true,
          "minimum": 100,
          "maximum": 599
        },
        {
          "path": [
            "WireBytes"
          ],
          "required": true,
          "minimum": 0,
          "maximumRef": "maxWireBytes"
        },
        {
          "path": [
            "TimingsMs",
            "ConnectAndHeaders"
          ],
          "required": true,
          "minimum": 0,
          "maximumRef": "requestTimingMsMax"
        },
        {
          "path": [
            "TimingsMs",
            "Total"
          ],
          "required": true,
          "minimum": 0,
          "maximumRef": "requestTimingMsMax"
        }
      ]
    },
    "redirect_followed": {
      "label": "research redirect event",
      "fields": [
