#!/usr/bin/env bash

set -euo pipefail
umask 077

readonly RHYOLITE_AGENT='rhyolite:repo-review'
readonly RHYOLITE_START_MARKER='RHYOLITE_START_COMMAND_V1'
readonly RHYOLITE_LAUNCHER_IMMEDIATE_START_MARKER='RHYOLITE_LAUNCHER_IMMEDIATE_START_V1'
readonly RHYOLITE_LAUNCHER_SETUP_MARKER='RHYOLITE_LAUNCHER_SETUP_V1'
readonly RHYOLITE_DEFAULT_MODEL='gpt-5.6-sol'
readonly RHYOLITE_OPUS_MODEL='claude-opus-5.5'
readonly RHYOLITE_FABLE_MODEL='claude-fable-5.1'
readonly RHYOLITE_CLAUDE_DEFAULT_MODEL='claude-opus-5-5'
readonly RHYOLITE_CLAUDE_ALTERNATE_MODEL='claude-opus-5'
readonly RHYOLITE_DEFAULT_REASONING_EFFORT='max'
readonly RHYOLITE_DEFAULT_CONTEXT_TIER='long_context'
RHYOLITE_SUPPORT_TEXT='SUPPORT.md and local documentation'
RHYOLITE_CONTRIBUTE_TEXT='CONTRIBUTING.md'
LAUNCHER_HARNESS='copilot'
LAUNCHER_HARNESS_DISPLAY='Copilot'
LAUNCHER_DEFAULT_MODEL="${RHYOLITE_DEFAULT_MODEL}"
# Ordered guided model choices for the selected harness; the first is the
# recommended default.
LAUNCHER_MODEL_IDS=(
    "${RHYOLITE_DEFAULT_MODEL}"
    "${RHYOLITE_OPUS_MODEL}"
    "${RHYOLITE_FABLE_MODEL}"
)
LAUNCHER_MODEL_LABELS=(
    'GPT-5.6 Sol (Recommended)'
    'Claude Opus 5.5'
    'Claude Fable 5.1'
)
LAUNCHER_MODEL_IDS_HINT='copilot help config'

sanitize_launcher_detail() {
    printf '%s' "$1" |
        LC_ALL=C tr -d '\000-\010\013-\037\177' |
        sed -E \
            -e 's#(https?://)[^/@[:space:]]+:[^/@[:space:]]+@#\1[credentials omitted]@#g' \
            -e 's/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/[email omitted]/g' \
            -e 's/((Authorization|authorization|Proxy-Authorization|proxy-authorization):[[:space:]]*)((Bearer|bearer|Basic|basic)[[:space:]]+)?[^[:space:]]+/\1[credential omitted]/g' \
            -e 's/(access[_-]?token|api[_-]?key|password|secret|token)[[:space:]]*[:=][[:space:]]*[^[:space:]]+/\1=[credential omitted]/g' \
            -e 's/(github_pat_|gh[pousr]_)[A-Za-z0-9_]{20,}/[credential omitted]/g' |
        tr '\r\n' '  '
}

fail() {
    local stage="$1"
    local summary="$2"
    local details="$3"
    local remediation="$4"
    local exit_code="${5:-1}"
    local artifacts="${6:-NONE}"
    local consequence="${7:-Copilot and guided repository-review setup did not start or complete.}"
    local safe_details

    safe_details="$(sanitize_launcher_detail "${details}")"
    [ -n "${safe_details}" ] ||
        safe_details='No additional safe detail was returned.'

    printf '%s\n' \
        'RHYOLITE ERROR' \
        "Summary: ${summary}" \
        "Stage: ${stage}" \
        'Source: NOT APPLICABLE' \
        "Details: ${safe_details} (exit code ${exit_code})" \
        "Consequence: ${consequence}" \
        "Remediation: ${remediation}" \
        "Artifacts: ${artifacts}" \
        "Support: ${RHYOLITE_SUPPORT_TEXT}" \
        "Contribute: ${RHYOLITE_CONTRIBUTE_TEXT}" >&2
    exit "${exit_code}"
}

configure_repository_links() {
    local plugin_root="$1"
    local metadata_path="${plugin_root}/branding/welcome-metadata.json"
    local home_url docs_url support_url issues_url pulls_url
    local value

    [ -f "${metadata_path}" ] || return 0
    home_url="$(
        sed -n 's/^[[:space:]]*"homeUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    docs_url="$(
        sed -n 's/^[[:space:]]*"docsUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    support_url="$(
        sed -n 's/^[[:space:]]*"supportUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    issues_url="$(
        sed -n 's/^[[:space:]]*"issuesUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    pulls_url="$(
        sed -n 's/^[[:space:]]*"pullsUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    for value in \
        "${home_url}" \
        "${docs_url}" \
        "${support_url}" \
        "${issues_url}" \
        "${pulls_url}"; do
        case "${value}" in
            ''|*'<PUBLIC_'*'>'*) return 0 ;;
        esac
    done
    RHYOLITE_SUPPORT_TEXT="${issues_url}"
    RHYOLITE_CONTRIBUTE_TEXT="${pulls_url}"
}

unexpected_launcher_error() {
    local exit_code="$1"
    local line_number="$2"
    trap - ERR
    fail \
        'launcher runtime' \
        'The launcher encountered an unexpected local setup failure.' \
        "A local launcher operation failed near line ${line_number}." \
        'Correct the preceding path, permission, or installation error and retry.' \
        "${exit_code}"
}

trap 'unexpected_launcher_error "$?" "${LINENO}"' ERR

resolve_physical_path() {
    local path="$1"
    local dir
    local target
    local symlink_hops=0

    case "${path}" in
        /*) ;;
        *) path="${PWD%/}/${path}" ;;
    esac

    while [ -L "${path}" ]; do
        symlink_hops=$((symlink_hops + 1))
        [ "${symlink_hops}" -le 40 ] ||
            fail \
                'launcher path resolution' \
                'The launcher path could not be resolved safely.' \
                "Too many symlink levels while resolving ${path}." \
                'Remove the symlink loop or invoke the packaged launcher from its physical path.' \
                2
        dir="$(cd -P "$(dirname "${path}")" && pwd)"
        target="$(readlink "${path}")" ||
            fail \
                'launcher path resolution' \
                'The launcher symlink could not be read.' \
                "Could not resolve symlink ${path}." \
                'Repair the symlink or invoke the packaged launcher from its physical path.' \
                2
        case "${target}" in
            /*) path="${target}" ;;
            *) path="${dir}/${target}" ;;
        esac
    done

    dir="$(cd -P "$(dirname "${path}")" && pwd)"
    printf '%s/%s\n' "${dir}" "$(basename "${path}")"
}

strip_control_chars() {
    printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177'
}

read_plugin_version() {
    local plugin_root="$1"
    local version

    version="$(
        sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${plugin_root}/plugin.json" | head -n 1
    )"
    [ -n "${version}" ] ||
        fail \
            'plugin validation' \
            'The installed plugin version is unavailable.' \
            "Could not read version from ${plugin_root}/plugin.json." \
            'Restore a valid plugin.json, then retry the launcher.' \
            2
    printf '%s\n' "${version}"
}

contains_git_marker() {
    [ -e "$1/.git" ]
}

get_clean_launch_dir() {
    local original_dir="$1"
    local cursor="${original_dir}"
    local last_git_root=""
    local parent

    while true; do
        if contains_git_marker "${cursor}"; then
            last_git_root="${cursor}"
        fi
        parent="$(dirname "${cursor}")"
        [ "${parent}" != "${cursor}" ] || break
        cursor="${parent}"
    done

    if [ -n "${last_git_root}" ]; then
        parent="$(dirname "${last_git_root}")"
        [ "${parent}" != "${last_git_root}" ] ||
            fail \
                'clean launch directory selection' \
                'A safe non-Git launch directory could not be derived.' \
                "The Git worktree root ${last_git_root} has no usable parent directory." \
                'Run the launcher from a normal filesystem location outside the target worktree.' \
                2
        printf '%s\n' "${parent}"
        return
    fi

    printf '%s\n' "${original_dir}"
}

assert_control_free_path() {
    case "$1" in
        *[$'\001'$'\002'$'\003'$'\004'$'\005'$'\006'$'\007'$'\010'$'\011'$'\012'$'\013'$'\014'$'\015'$'\016'$'\017'$'\020'$'\021'$'\022'$'\023'$'\024'$'\025'$'\026'$'\027'$'\030'$'\031'$'\032'$'\033'$'\034'$'\035'$'\036'$'\037'$'\177']*)
            fail \
                'launcher path validation' \
                'A required launcher path contains control characters.' \
                "Rejected path: $1" \
                'Move the checkout or working directory to a control-free path and retry.' \
                2
            ;;
    esac
}

create_session_dir() {
    local base_dir="$1"
    local state_anchor
    local timestamp
    local attempt=0
    local session_id
    local session_dir

    state_anchor="$(rhyolite_launcher_state_anchor)"
    if ! rhyolite_prepare_secure_user_directory \
        "${state_anchor}" "${base_dir}" ||
        ! rhyolite_prepare_secure_user_directory \
            "${state_anchor}" "${base_dir}/sessions"; then
        fail \
            'launcher state creation' \
            'Launcher state failed secure-path validation.' \
            "Launcher state under ${base_dir} must be owned by the current user, contain no symlink components, and have no group/world-writable components." \
            'Choose a private user-owned state directory with ordinary directories only, then retry.' \
            2 \
            "${base_dir}"
    fi
    chmod 700 "${base_dir}" "${base_dir}/sessions" ||
        fail \
            'launcher state creation' \
            'Launcher state could not be restricted to the current user.' \
            "Could not secure launcher state under ${base_dir}." \
            'Choose a writable user-owned state directory and retry.' \
            2 \
            "${base_dir}"

    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    while true; do
        session_id="${timestamp}-$$"
        if [ "${attempt}" -gt 0 ]; then
            session_id="${session_id}-${attempt}"
        fi
        session_dir="${base_dir}/sessions/${session_id}"
        if mkdir "${session_dir}" 2>/dev/null; then
            printf '%s\n' "${session_dir}"
            return
        fi
        [ -e "${session_dir}" ] ||
            fail \
                'launcher state creation' \
                'A unique launcher session directory could not be created.' \
                "Could not create ${session_dir}." \
                'Check available space and permissions under the launcher state directory, then retry.' \
                2 \
                "${base_dir}"
        attempt=$((attempt + 1))
    done
}

join_initial_request() {
    local joined=''
    local part
    local sanitized

    for part in "$@"; do
        sanitized="$(strip_control_chars "${part}")"
        case "${sanitized}" in
            *[![:space:]]*) ;;
            *) continue ;;
        esac
        if [ -n "${joined}" ]; then
            joined="${joined} ${sanitized}"
        else
            joined="${sanitized}"
        fi
    done

    printf '%s' "${joined}"
}

# Remove the brackets, quotes, and sentence punctuation that commonly wrap a
# URL typed in prose, so "(https://host/owner/repository)," still selects it.
trim_url_token() {
    local token="$1"

    while :; do
        case "${token}" in
            [\(\[\<\"\']*) token="${token#?}" ;;
            *[,\;.:\!\?\)\]\>\"\']) token="${token%?}" ;;
            *) break ;;
        esac
    done
    printf '%s' "${token}"
}

# Split text into comma- and whitespace-separated tokens without pathname
# expansion, trimming each token's wrapping punctuation.
split_url_tokens() {
    local token
    local -a tokens=()

    read -r -a tokens <<< "${1//,/ }"
    for token in "${tokens[@]}"; do
        token="$(trim_url_token "${token}")"
        if [[ -n "${token}" ]]; then
            printf '%s\n' "${token}"
        fi
    done
}

is_https_url_token() {
    case "$(rhyolite_ascii_lower "${1:0:8}")" in
        https://) return 0 ;;
    esac
    return 1
}

extract_repository_urls_from_request() {
    local token

    while IFS= read -r token; do
        if is_https_url_token "${token}"; then
            printf '%s\n' "${token}"
        fi
    done < <(split_url_tokens "$1")
}

# A request that holds only repository URLs adds nothing beyond the sources
# the launcher already selected from it.
request_has_non_url_text() {
    local token

    while IFS= read -r token; do
        is_https_url_token "${token}" || return 0
    done < <(split_url_tokens "$1")
    return 1
}

split_repository_input() {
    split_url_tokens "$1"
}

# Spellings of one repository that differ only by a terminal .git endpoint
# select it once; the first spelling remains the selected source.
repository_selection_key() {
    local repository="$1"

    case "$(rhyolite_ascii_lower "${repository}")" in
        *.git) repository="${repository%????}" ;;
    esac
    printf '%s' "${repository}"
}

# A canonical github.com URL with a single path segment names an account or
# organization, never a repository, so it would only fail the anonymous
# access check after the harness had started.
github_account_without_repository() {
    local path

    case "$1" in
        https://github.com/*) path="${1#https://github.com/}" ;;
        https://www.github.com/*) path="${1#https://www.github.com/}" ;;
        *) return 1 ;;
    esac
    [[ -n "${path}" && "${path}" != */* ]]
}

launcher_model_accepted() {
    local candidate_model="$1"
    local allow_unlisted_model="$2"

    if rhyolite_harness_invoke \
        harness_validate_model_id "${candidate_model}" >/dev/null 2>&1; then
        return 0
    fi
    [[ "${allow_unlisted_model}" == 1 &&
        "${RHYOLITE_HARNESS_LAST_STATUS}" == \
            "${RHYOLITE_HARNESS_MODEL_UNLISTED_STATUS}" ]]
}

launcher_model_unlisted() {
    [[ "${RHYOLITE_HARNESS_LAST_STATUS}" == \
        "${RHYOLITE_HARNESS_MODEL_UNLISTED_STATUS}" ]]
}

prompt_for_model() {
    local remembered_model="$1"
    local allow_unlisted_model="$2"
    local answer candidate_model index list_choice other_choice
    local -a choice_models=()

    while true; do
        printf '\nReview model\n' >&2
        choice_models=()
        if [[ -n "${remembered_model}" ]]; then
            printf '  1. Keep previously used (%s)\n' \
                "${remembered_model}" >&2
            choice_models+=("${remembered_model}")
        fi
        for index in "${!LAUNCHER_MODEL_IDS[@]}"; do
            printf '  %d. %s - %s\n' "$((${#choice_models[@]} + 1))" \
                "${LAUNCHER_MODEL_LABELS[index]}" \
                "${LAUNCHER_MODEL_IDS[index]}" >&2
            choice_models+=("${LAUNCHER_MODEL_IDS[index]}")
        done
        list_choice=$((${#choice_models[@]} + 1))
        other_choice=$((list_choice + 1))
        printf '  %d. List available model IDs\n' "${list_choice}" >&2
        printf '  %d. Enter another frontier model ID\n' "${other_choice}" >&2
        printf 'Select model [1]: ' >&2
        IFS= read -r answer
        answer="${answer:-1}"
        if [[ "${answer}" =~ ^[1-9][0-9]*$ ]] &&
            ((answer <= ${#choice_models[@]})); then
            candidate_model="${choice_models[answer - 1]}"
        elif [[ "${answer}" == "${list_choice}" ]]; then
            print_available_models
            continue
        elif [[ "${answer}" == "${other_choice}" ]]; then
            candidate_model=''
        else
            printf 'Enter one of the displayed choice numbers.\n' >&2
            continue
        fi

        if [[ -z "${candidate_model}" ]]; then
            printf 'Available model ID: ' >&2
            IFS= read -r candidate_model
        fi
        if launcher_model_accepted \
            "${candidate_model}" "${allow_unlisted_model}"; then
            printf '%s\n' "${candidate_model}"
            return
        fi
        printf 'Model selection rejected: %s\n' \
            "${RHYOLITE_HARNESS_ERROR_DETAIL:-not available to this ${LAUNCHER_HARNESS_DISPLAY} CLI installation}" >&2
        if launcher_model_unlisted; then
            printf '%s\n' \
                'Restart the launcher with --allow-unlisted-model to use a model ID outside the offline catalog.' >&2
        fi
    done
}

print_available_models() {
    local available_models
    local model

    if ! available_models="$(harness_list_models)"; then
        printf 'Could not list models: %s\n' \
            "${RHYOLITE_HARNESS_ERROR_DETAIL:-${LAUNCHER_HARNESS_DISPLAY} model catalog unavailable.}" >&2
        return
    fi
    printf '\nAvailable %s model IDs\n' "${LAUNCHER_HARNESS_DISPLAY}" >&2
    while IFS= read -r model; do
        [[ -n "${model}" ]] && printf '  %s\n' "${model}" >&2
    done <<< "${available_models}"
}

prompt_for_reasoning_effort() {
    local remembered_effort="$1"
    local answer

    while true; do
        printf '\nReasoning effort\n' >&2
        if [[ -n "${remembered_effort}" ]]; then
            printf '  1. Keep previously used (%s)\n' \
                "${remembered_effort}" >&2
            printf '  2. Maximum reasoning (Recommended) - max\n' >&2
            printf '  3. Extra-high reasoning - xhigh\n' >&2
            printf '  4. High reasoning - high\n' >&2
            printf 'Select effort [1]: ' >&2
            IFS= read -r answer
            case "${answer:-1}" in
                1) printf '%s\n' "${remembered_effort}"; return ;;
                2) printf '%s\n' max; return ;;
                3) printf '%s\n' xhigh; return ;;
                4) printf '%s\n' high; return ;;
            esac
        else
            printf '  1. Maximum reasoning (Recommended) - max\n' >&2
            printf '  2. Extra-high reasoning - xhigh\n' >&2
            printf '  3. High reasoning - high\n' >&2
            printf 'Select effort [1]: ' >&2
            IFS= read -r answer
            case "${answer:-1}" in
                1) printf '%s\n' max; return ;;
                2) printf '%s\n' xhigh; return ;;
                3) printf '%s\n' high; return ;;
            esac
        fi
        printf 'Enter one of the displayed choice numbers.\n' >&2
    done
}

prompt_for_context_tier() {
    local remembered_context="$1"
    local answer

    while true; do
        printf '\nContext tier\n' >&2
        if [[ -n "${remembered_context}" ]]; then
            printf '  1. Keep previously used (%s)\n' \
                "${remembered_context}" >&2
            printf '  2. Long context (Recommended) - long_context\n' >&2
            printf '  3. Default context - default\n' >&2
            printf 'Select context [1]: ' >&2
            IFS= read -r answer
            case "${answer:-1}" in
                1) printf '%s\n' "${remembered_context}"; return ;;
                2) printf '%s\n' long_context; return ;;
                3) printf '%s\n' default; return ;;
            esac
        else
            printf '  1. Long context (Recommended) - long_context\n' >&2
            printf '  2. Default context - default\n' >&2
            printf 'Select context [1]: ' >&2
            IFS= read -r answer
            case "${answer:-1}" in
                1) printf '%s\n' long_context; return ;;
                2) printf '%s\n' default; return ;;
            esac
        fi
        printf 'Enter one of the displayed choice numbers.\n' >&2
    done
}

prompt_to_confirm_runtime_settings() {
    local harness="$1"
    local model="$2"
    local reasoning_effort="$3"
    local context_tier="$4"
    local answer

    printf '\nValidated review runtime\n' >&2
    printf '  Harness: %s\n' "${harness}" >&2
    printf '  Model: %s\n' "${model}" >&2
    printf '  Reasoning effort: %s\n' "${reasoning_effort}" >&2
    printf '  Context tier: %s\n' "${context_tier}" >&2
    printf '  1. Confirm settings\n' >&2
    printf '  2. Modify model\n' >&2
    printf '  3. Modify reasoning effort\n' >&2
    printf '  4. Modify context tier\n' >&2
    printf 'Select action [1]: ' >&2
    IFS= read -r answer
    case "${answer:-1}" in
        1) printf '%s\n' confirm ;;
        2) printf '%s\n' model ;;
        3) printf '%s\n' effort ;;
        4) printf '%s\n' context ;;
        *) printf '%s\n' invalid ;;
    esac
}

build_launcher_setup_block() {
    local model="$1"
    local reasoning_effort="$2"
    local context_tier="$3"
    local allow_unlisted_model="$4"
    shift 4
    local repository

    printf '%s\n' "${RHYOLITE_LAUNCHER_SETUP_MARKER}"
    for repository in "$@"; do
        printf 'Source=%s\n' "${repository}"
    done
    printf 'Model=%s\n' "${model}"
    if [[ "${allow_unlisted_model}" == 1 ]]; then
        printf 'AllowUnlistedModel=true\n'
    fi
    printf 'ReasoningEffort=%s\n' "${reasoning_effort}"
    printf 'ContextTier=%s\n' "${context_tier}"
    printf 'RememberPreferences=true\n'
    printf 'END_%s\n' "${RHYOLITE_LAUNCHER_SETUP_MARKER}"
}

build_start_request() {
    local initial_request="$1"

    printf "Begin Rhyolite's guided repository-review setup now."
    if [ -n "${initial_request}" ]; then
        printf "\nTreat the following text as the user's initial review request:\n\n%s" \
            "${initial_request}"
    fi
}

build_initial_prompt() {
    local initial_request="$1"
    local model="$2"
    local reasoning_effort="$3"
    local context_tier="$4"
    local allow_unlisted_model="$5"
    shift 5

    printf '%s\n' "${RHYOLITE_START_MARKER}"
    build_launcher_setup_block \
        "${model}" \
        "${reasoning_effort}" \
        "${context_tier}" \
        "${allow_unlisted_model}" \
        "$@"
    build_start_request "${initial_request}"
}

write_launch_context() {
    local context_path="$1"
    local version="$2"
    local original_dir="$3"
    local launch_dir="$4"
    local plugin_root="$5"
    local model="$6"
    local reasoning_effort="$7"
    local context_tier="$8"
    local allow_unlisted_model="$9"

    {
        printf 'StartedAtUtc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'Version=%s\n' "${version}"
        printf 'OriginalWorkingDirectory=%s\n' "${original_dir}"
        printf 'LaunchDirectory=%s\n' "${launch_dir}"
        printf 'PluginRoot=%s\n' "${plugin_root}"
        printf 'Model=%s\n' "${model}"
        if [[ "${allow_unlisted_model}" == 1 ]]; then
            printf 'AllowUnlistedModel=true\n'
        fi
        printf 'ReasoningEffort=%s\n' "${reasoning_effort}"
        printf 'ContextTier=%s\n' "${context_tier}"
        printf 'RememberPreferences=true\n'
    } > "${context_path}"
}

# Copilot's interactive session silently switches to its default model when
# the selected model is unavailable to the account (re-verified with Copilot
# CLI 1.0.100: "Falling back to next option"), while non-interactive Copilot
# rejects an unavailable model or reasoning effort before any model call.
# Before the interactive session starts, one short non-interactive request in
# an isolated runtime home inside this launch's private session directory
# asks Copilot to answer with the selected model, reasoning effort, and
# context, and the adapter's normalizer verifies that exactly that model and
# effort answered.
readonly LAUNCHER_ACCESS_PROMPT='Rhyolite model check. Reply with exactly: OK'
LAUNCHER_ACCESS_RESULT=''
LAUNCHER_ACCESS_DETAIL=''
LAUNCHER_ACCESS_ROOT=''
LAUNCHER_ACCESS_LOCK=''
LAUNCHER_ACCESS_SEQUENCE=0
LAUNCHER_ACCESS_MODEL=''
LAUNCHER_ACCESS_EFFORT=''

finish_copilot_model_access_check() {
    [[ -n "${LAUNCHER_ACCESS_ROOT}" && -d "${LAUNCHER_ACCESS_ROOT}" ]] ||
        return 0
    rhyolite_harness_invoke harness_sanitize_runtime_home \
        "${LAUNCHER_ACCESS_ROOT}/home" >/dev/null 2>&1 || true
    rm -rf -- "${LAUNCHER_ACCESS_ROOT}" 2>/dev/null || true
    rhyolite_unlock_runtime_home "${LAUNCHER_ACCESS_LOCK}"
    LAUNCHER_ACCESS_LOCK=''
    LAUNCHER_ACCESS_ROOT=''
}

# A launcher killed during its model check cannot remove that check's
# runtime home, with its authentication bridge, from its session directory.
sweep_stale_model_check_homes() {
    local sessions_dir="$1"
    local session

    for session in "${sessions_dir}"/*; do
        [[ -d "${session}" && ! -L "${session}" && -O "${session}" ]] ||
            continue
        rhyolite_sweep_stale_runtime_homes \
            "${session}" "${RHYOLITE_LAUNCHER_RUNTIME_HOME_PATTERN}"
    done
}

# Sets LAUNCHER_ACCESS_RESULT to available, model-unavailable,
# effort-unsupported, effort-unconfigurable, or unverified, and
# LAUNCHER_ACCESS_DETAIL to one line of Copilot's own explanation. Each check
# creates a new model-check-<n> directory in the private, per-launch
# check_parent directory and removes it before returning.
check_copilot_model_access() {
    local copilot_command="$1"
    local model="$2"
    local reasoning_effort="$3"
    local context_tier="$4"
    local check_parent="$5"
    local check_root
    local authentication_names=''
    local check_output=''
    local check_status=0
    local -a check_environment=()
    local -a check_arguments=()

    LAUNCHER_ACCESS_RESULT='unverified'
    LAUNCHER_ACCESS_DETAIL='Rhyolite could not prepare an isolated Copilot model check.'
    LAUNCHER_ACCESS_SEQUENCE=$((LAUNCHER_ACCESS_SEQUENCE + 1))
    check_root="${check_parent}/model-check-${LAUNCHER_ACCESS_SEQUENCE}"
    [[ -n "${check_parent}" && -d "${check_parent}" ]] || return 0
    trap 'finish_copilot_model_access_check; exit 130' INT TERM HUP
    if ! mkdir -m 700 -- "${check_root}" 2>/dev/null; then
        trap - INT TERM HUP
        return 0
    fi
    LAUNCHER_ACCESS_ROOT="${check_root}"
    if ! rhyolite_lock_runtime_home \
            "${LAUNCHER_ACCESS_ROOT}" LAUNCHER_ACCESS_LOCK 2>/dev/null ||
        ! mkdir -m 700 -- \
            "${LAUNCHER_ACCESS_ROOT}/home" "${LAUNCHER_ACCESS_ROOT}/cwd" ||
        ! rhyolite_harness_invoke harness_prepare_run >/dev/null 2>&1 ||
        ! rhyolite_harness_invoke harness_prepare_worker_home \
            "${LAUNCHER_ACCESS_ROOT}/home" \
            "${reasoning_effort}" \
            "${context_tier}" \
            review >/dev/null 2>&1 ||
        ! rhyolite_harness_invoke harness_worker_env check_environment \
            >/dev/null 2>&1 ||
        ! authentication_names="$(
            harness_auth_secret_env_vars | paste -sd, -
        )"; then
        finish_copilot_model_access_check
        trap - INT TERM HUP
        return 0
    fi
    check_arguments=(
        -C "${LAUNCHER_ACCESS_ROOT}/cwd"
        --model "${model}"
        --reasoning-effort "${reasoning_effort}"
        --context "${context_tier}"
        --no-ask-user
        --no-color
        --no-custom-instructions
        --disable-builtin-mcps
        --disallow-temp-dir
        --sync-session=off
        --secret-env-vars "${authentication_names}"
        --available-tools view
        --deny-tool write
        --deny-tool shell
        --stream off
        --output-format json
    )
    printf '%s' "${LAUNCHER_ACCESS_PROMPT}" |
        timeout --signal=TERM --kill-after=10s 120s \
            env "${check_environment[@]}" \
            "${copilot_command}" "${check_arguments[@]}" \
            > "${LAUNCHER_ACCESS_ROOT}/stdout" \
            2> "${LAUNCHER_ACCESS_ROOT}/stderr" ||
        check_status=$?
    check_output="$(
        cat -- "${LAUNCHER_ACCESS_ROOT}/stderr" \
            "${LAUNCHER_ACCESS_ROOT}/stdout" 2>/dev/null |
            LC_ALL=C tr -d '\000-\010\013-\037\177' | head -c 65536
    )" || true
    LAUNCHER_ACCESS_DETAIL="$(
        grep -E -m 1 -v '^[[:space:]]*(\{|$)' <<< "${check_output}" |
            cut -c 1-300
    )" || true
    if grep -Eq \
        '[Mm]odel "[A-Za-z0-9][A-Za-z0-9._-]*"[^"]* is not available' \
        <<< "${check_output}"; then
        LAUNCHER_ACCESS_RESULT='model-unavailable'
    elif grep -Eq \
        'Reasoning effort "[a-z]+" is not supported for model "[A-Za-z0-9][A-Za-z0-9._-]*"' \
        <<< "${check_output}"; then
        LAUNCHER_ACCESS_RESULT='effort-unsupported'
    elif grep -Eq \
        '[Mm]odel "[A-Za-z0-9][A-Za-z0-9._-]*" does not support reasoning effort configuration' \
        <<< "${check_output}"; then
        LAUNCHER_ACCESS_RESULT='effort-unconfigurable'
    elif ((check_status == 0)); then
        if rhyolite_harness_invoke harness_normalize_worker_output \
            review \
            "${LAUNCHER_ACCESS_ROOT}/stdout" \
            "${model}" \
            "${reasoning_effort}" \
            "${LAUNCHER_ACCESS_ROOT}/normalized" \
            "${LAUNCHER_ACCESS_ROOT}/reply" >/dev/null 2>&1; then
            LAUNCHER_ACCESS_RESULT='available'
        else
            LAUNCHER_ACCESS_DETAIL="${RHYOLITE_HARNESS_ERROR_DETAIL:-The Copilot answer could not be verified.}"
        fi
    elif [[ -z "${LAUNCHER_ACCESS_DETAIL}" ]]; then
        LAUNCHER_ACCESS_DETAIL="Copilot exited with status ${check_status} without an explanation."
    fi
    finish_copilot_model_access_check
    trap - INT TERM HUP
}

next_lower_reasoning_effort() {
    case "$1" in
        max) printf '%s\n' xhigh ;;
        xhigh) printf '%s\n' high ;;
        *) printf '\n' ;;
    esac
}

# Asks how to continue after Copilot rejected the selected model or effort.
# There is no default answer, so the effort is never lowered without an
# explicit choice; end of input quits.
prompt_for_model_access_action() {
    local summary="$1"
    local next_reasoning_effort="$2"
    local answer

    while true; do
        printf '\n%s\n' "${summary}" >&2
        printf '%s\n' \
            'Rhyolite stops here so that Copilot does not silently run setup on a different model or effort.' >&2
        printf 'Model check\n' >&2
        if [[ -n "${next_reasoning_effort}" ]]; then
            printf '  1. Use %s, the next highest reasoning effort\n' \
                "${next_reasoning_effort}" >&2
            printf '  2. Choose another model\n' >&2
            printf '  3. Quit\n' >&2
            printf 'Select action: ' >&2
            IFS= read -r answer || answer=3
            case "${answer}" in
                1) printf '%s\n' effort; return ;;
                2) printf '%s\n' model; return ;;
                3) printf '%s\n' quit; return ;;
            esac
        else
            printf '  1. Choose another model\n' >&2
            printf '  2. Quit\n' >&2
            printf 'Select action: ' >&2
            IFS= read -r answer || answer=2
            case "${answer}" in
                1) printf '%s\n' model; return ;;
                2) printf '%s\n' quit; return ;;
            esac
        fi
        printf 'Enter one of the displayed choice numbers.\n' >&2
    done
}

# Checks LAUNCHER_ACCESS_MODEL at LAUNCHER_ACCESS_EFFORT until Copilot accepts
# them or the check cannot be completed. Interactively, a rejected model or
# effort asks for another model, the next highest effort (never below high),
# or quit; without a terminal it stops with a launcher error. Returns 3 when
# the user quits. check_parent is this launch's private session directory.
ensure_copilot_model_access() {
    local copilot_command="$1"
    local context_tier="$2"
    local interactive="$3"
    local allow_unlisted_model="$4"
    local check_parent="$5"
    local summary next_reasoning_effort remediation action

    while true; do
        printf 'Checking that Copilot accepts %s at %s reasoning effort (one short request)...\n' \
            "${LAUNCHER_ACCESS_MODEL}" "${LAUNCHER_ACCESS_EFFORT}" >&2
        check_copilot_model_access \
            "${copilot_command}" \
            "${LAUNCHER_ACCESS_MODEL}" \
            "${LAUNCHER_ACCESS_EFFORT}" \
            "${context_tier}" \
            "${check_parent}"
        next_reasoning_effort=''
        case "${LAUNCHER_ACCESS_RESULT}" in
            available)
                printf 'Copilot accepted %s at %s reasoning effort.\n' \
                    "${LAUNCHER_ACCESS_MODEL}" "${LAUNCHER_ACCESS_EFFORT}" >&2
                return 0
                ;;
            model-unavailable)
                summary="Copilot reports that model ${LAUNCHER_ACCESS_MODEL} is not available to your account."
                remediation='Pass --model with a model that your Copilot account can use, or run the launcher in a terminal to choose one.'
                ;;
            effort-unsupported)
                summary="Copilot reports that model ${LAUNCHER_ACCESS_MODEL} does not accept ${LAUNCHER_ACCESS_EFFORT} reasoning effort."
                next_reasoning_effort="$(
                    next_lower_reasoning_effort "${LAUNCHER_ACCESS_EFFORT}"
                )"
                if [[ -n "${next_reasoning_effort}" ]]; then
                    remediation="Pass --reasoning-effort ${next_reasoning_effort}, the next highest effort, or --model with another model, or run the launcher in a terminal to choose."
                else
                    remediation='Pass --model with another model that accepts high or higher reasoning effort, or run the launcher in a terminal to choose one.'
                fi
                ;;
            effort-unconfigurable)
                summary="Copilot reports that model ${LAUNCHER_ACCESS_MODEL} does not accept a reasoning-effort setting, and Rhyolite requires at least high."
                remediation='Pass --model with another model that accepts high or higher reasoning effort, or run the launcher in a terminal to choose one.'
                ;;
            *)
                printf 'Warning: Rhyolite could not verify that Copilot accepts %s at %s reasoning effort (%s). If it does not, Copilot may run the setup session on another model; the review itself still fails closed.\n' \
                    "${LAUNCHER_ACCESS_MODEL}" \
                    "${LAUNCHER_ACCESS_EFFORT}" \
                    "$(sanitize_launcher_detail "${LAUNCHER_ACCESS_DETAIL:-no detail}")" >&2
                return 0
                ;;
        esac
        if [[ "${interactive}" != 1 ]]; then
            fail \
                'launcher model availability' \
                "${summary}" \
                "${LAUNCHER_ACCESS_DETAIL}" \
                "${remediation}" \
                2 \
                'NONE' \
                'Copilot and guided repository-review setup did not start; Rhyolite never lowers the reasoning effort or switches models without your choice.'
        fi
        action="$(
            prompt_for_model_access_action \
                "${summary}" "${next_reasoning_effort}"
        )"
        case "${action}" in
            effort)
                LAUNCHER_ACCESS_EFFORT="${next_reasoning_effort}"
                ;;
            model)
                LAUNCHER_ACCESS_MODEL="$(
                    prompt_for_model '' "${allow_unlisted_model}"
                )"
                ;;
            *)
                return 3
                ;;
        esac
    done
}

print_help() {
    local version="$1"

    cat <<EOF
Rhyolite v${version} Beta

Usage:
  rhyolite [--help]
  rhyolite [--version]
  rhyolite [--repo URL]... [--harness ID] [--model MODEL]
           [--allow-unlisted-model]
           [--reasoning-effort high|xhigh|max]
           [--context default|long_context] [--yolo]
           [--] [URL...] [initial review request...]

Options:
  --repo URL          Add a public HTTPS Git repository to review. Repeat
                      --repo or separate URLs with commas or spaces. Every
                      public HTTPS URL on the command line, including URLs in
                      the initial review request, is reviewed; spellings that
                      differ only by a trailing .git are reviewed once.
  --harness ID        Select a registered review harness.
  --model MODEL       Select an exact ID from Copilot's offline model catalog
                      (default: gpt-5.6-sol; alternates: claude-opus-5.5,
                      claude-fable-5.1).
                      With --harness claude, select from Rhyolite's Claude
                      Code catalog (default: claude-opus-5-5; alternate:
                      claude-opus-5).
  --allow-unlisted-model
                      Also accept a safe model ID that is missing from that
                      catalog; Copilot verifies availability when the review
                      runs, and the review never substitutes another model.
  --reasoning-effort  Select high, xhigh, or max (recommended).
  --context TIER      Select default or long_context (recommended).
  --yolo         Start Copilot in YOLO mode for this launch (Claude Code:
                 skip permission prompts).

Available harnesses:
$(rhyolite_harness_list_registered | sed 's/^/  - /')

Starts Copilot (or Claude Code with --harness claude) outside Git worktrees
with the checkout-loaded Rhyolite plugin, collects launcher settings, selects
${RHYOLITE_AGENT}, starts explicit interactive mode, and begins guided setup
immediately. Approved model/effort/context settings are remembered per
repository and harness.

Unknown options and GitHub URLs without a repository name are rejected before
the harness starts. Put review request text that begins with a hyphen after --.
EOF
}

main() {
    local script_path
    local script_dir
    local plugin_root
    local harness_common
    local version
    local mode='launch'
    local original_dir
    local launch_dir
    local launcher_home
    local session_dir
    local log_dir
    local initial_request
    local initial_prompt
    local requested_harness=''
    local harness
    local model=''
    local reasoning_effort=''
    local context_tier=''
    local allow_unlisted_model=0
    local yolo=0
    local remembered_model=''
    local remembered_reasoning_effort=''
    local remembered_context_tier=''
    local remembered_consistent=1
    local confirmation_action
    local preference_status
    local repository_input
    local repository
    local repository_key
    local repository_input_count
    local existing_repository
    local duplicate
    local invalid_repository=''
    local is_interactive=0
    local copilot_path
    local copilot_exit_code
    local model_access_status
    local harness_cli
    local claude_settings
    local claude_setup_block
    local claude_start_prompt
    local escaped_plugin_root
    local preferences_helper
    local -a request_parts=()
    local -a repository_inputs=()
    local -a repositories=()
    local -a copilot_arguments=()
    local -a claude_arguments=()

    script_path="$(resolve_physical_path "${BASH_SOURCE[0]}")"
    script_dir="$(cd -P "$(dirname "${script_path}")" && pwd)"
    plugin_root="$(cd -P "${script_dir}/.." && pwd)"
    harness_common="${plugin_root}/lib/harness/common.sh"
    [ -f "${harness_common}" ] ||
        fail \
            'launcher harness validation' \
            'The launcher harness helper is missing.' \
            "Harness helper was not found at ${harness_common}." \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2
    # shellcheck source=../lib/harness/common.sh
    source "${harness_common}"
    configure_repository_links "${plugin_root}"

    [ -f "${plugin_root}/plugin.json" ] ||
        fail \
            'plugin validation' \
            'Required plugin metadata is missing.' \
            "Plugin metadata was not found under ${plugin_root}." \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2
    [ -f "${plugin_root}/commands/start.md" ] ||
        fail \
            'plugin validation' \
            'The Rhyolite start command is missing.' \
            "Start command was not found under ${plugin_root}." \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2
    [ -f "${plugin_root}/agents/repo-review.agent.md" ] ||
        fail \
            'plugin validation' \
            'The Rhyolite review agent is missing.' \
            "Repo-review agent was not found under ${plugin_root}." \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2

    preferences_helper="${plugin_root}/scripts/launcher-preferences.sh"
    [ -f "${preferences_helper}" ] ||
        fail \
            'launcher preference validation' \
            'The launcher preference helper is missing.' \
            "Preference helper was not found at ${preferences_helper}." \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2
    # shellcheck source=../scripts/launcher-preferences.sh
    source "${preferences_helper}"

    version="$(read_plugin_version "${plugin_root}")"

    if [ "$#" -gt 0 ]; then
        case "$1" in
            --help|-h)
                mode='help'
                shift
                ;;
            --version|-v)
                mode='version'
                shift
                ;;
        esac
    fi

    if [ "${mode}" = 'help' ]; then
        [ "$#" -eq 0 ] ||
            fail \
                'launcher argument validation' \
                'The help request included unsupported extra arguments.' \
                '--help does not accept additional arguments.' \
                'Run rhyolite --help without any other arguments.' \
                2
        print_help "${version}"
        exit 0
    fi

    if [ "${mode}" = 'version' ]; then
        [ "$#" -eq 0 ] ||
            fail \
                'launcher argument validation' \
                'The version request included unsupported extra arguments.' \
                '--version does not accept additional arguments.' \
                'Run rhyolite --version without any other arguments.' \
                2
        printf 'Rhyolite v%s Beta\n' "${version}"
        exit 0
    fi

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo)
                [ "$#" -ge 2 ] && [ -n "$2" ] ||
                    fail \
                        'launcher argument validation' \
                        'A repository URL argument is missing.' \
                        '--repo requires a public HTTPS Git repository URL.' \
                        'Pass --repo URL or omit it to use interactive launcher setup.' \
                        2
                repository_input_count=${#repository_inputs[@]}
                while IFS= read -r repository; do
                    repository_inputs+=("${repository}")
                done < <(split_repository_input "$2")
                ((${#repository_inputs[@]} > repository_input_count)) ||
                    fail \
                        'launcher argument validation' \
                        'A repository URL argument is missing.' \
                        '--repo requires a public HTTPS Git repository URL.' \
                        'Pass --repo URL or omit it to use interactive launcher setup.' \
                        2
                shift 2
                ;;
            --fleet-mode)
                # Retired: Copilot fleet mode only changed the outer setup
                # session, which never starts subagents. The standard value
                # stays accepted, with no effect, for existing scripts.
                [ "$#" -ge 2 ] ||
                    fail \
                        'launcher argument validation' \
                        'A fleet mode argument is missing.' \
                        '--fleet-mode is retired and accepts only standard, which has no effect.' \
                        'Remove --fleet-mode and retry.' \
                        2
                case "$2" in
                    standard) ;;
                    native)
                        fail \
                            'launcher argument validation' \
                            'Native fleet mode has been retired.' \
                            'Copilot fleet mode only changed the outer setup session, which never starts subagents; the trusted runner already reviews selected repositories in parallel.' \
                            'Remove --fleet-mode native and retry.' \
                            2
                        ;;
                    *)
                        fail \
                            'launcher argument validation' \
                            'The requested fleet mode is invalid.' \
                            "Unsupported fleet mode: $2" \
                            'Remove --fleet-mode and retry.' \
                            2
                        ;;
                esac
                shift 2
                ;;
            --harness)
                [ "$#" -ge 2 ] && [ -n "$2" ] ||
                    fail \
                        'launcher argument validation' \
                        'A harness identifier is missing.' \
                        '--harness requires a supported harness identifier.' \
                        'Pass --harness copilot or omit it to use the default.' \
                        2
                requested_harness="$2"
                shift 2
                ;;
            --harness=*)
                fail \
                    'launcher argument validation' \
                    'The harness option used unsupported equals-form syntax.' \
                    'The launcher accepts the harness identifier only as a separate argument.' \
                    'Use --harness ID, for example --harness copilot.' \
                    2
                ;;
            --model)
                [ "$#" -ge 2 ] && rhyolite_valid_model_id "$2" ||
                    fail \
                        'launcher argument validation' \
                        'The requested model identifier is invalid.' \
                        '--model requires a safe Copilot model identifier.' \
                        'Use letters, numbers, dots, underscores, and hyphens only.' \
                        2
                model="$2"
                shift 2
                ;;
            --allow-unlisted-model)
                allow_unlisted_model=1
                shift
                ;;
            --reasoning-effort)
                [ "$#" -ge 2 ] &&
                    rhyolite_valid_reasoning_effort "$2" ||
                    fail \
                        'launcher argument validation' \
                        'The requested reasoning effort is invalid.' \
                        '--reasoning-effort requires high, xhigh, or max.' \
                        'Use --reasoning-effort max unless a lower supported tier is intentional.' \
                        2
                reasoning_effort="$2"
                shift 2
                ;;
            --context)
                [ "$#" -ge 2 ] &&
                    rhyolite_valid_context_tier "$2" ||
                    fail \
                        'launcher argument validation' \
                        'The requested context tier is invalid.' \
                        '--context requires default or long_context.' \
                        'Use --context long_context unless the default context window is intentional.' \
                        2
                context_tier="$2"
                shift 2
                ;;
            --yolo)
                yolo=1
                shift
                ;;
            --autopilot)
                fail \
                    'launcher argument validation' \
                    'The launcher --autopilot option has been retired.' \
                    'Rhyolite no longer forwards --autopilot because guided setup and effective-plan approval must remain interactive.' \
                    'Remove --autopilot and retry. Rhyolite starts explicitly in interactive mode and keeps the approved review model bound to the effective plan.' \
                    2
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    request_parts+=("$1")
                    shift
                done
                ;;
            --help|-h|--version|-v)
                fail \
                    'launcher argument validation' \
                    "The $1 option must be the only argument." \
                    "$1 was combined with other launcher arguments." \
                    "Run rhyolite $1 without any other arguments." \
                    2
                ;;
            # A mistyped option must not become review request text: it
            # would start the default harness and spend credits.
            -?*)
                fail \
                    'launcher argument validation' \
                    'The launcher does not recognize an option.' \
                    "Unknown option: $1" \
                    'Check the option against rhyolite --help; options take their values as separate arguments. To start the review request with a hyphen, put the request after --.' \
                    2
                ;;
            *)
                request_parts+=("$1")
                shift
                ;;
        esac
    done

    harness="$(rhyolite_harness_resolve "${requested_harness}")" ||
        fail \
            'launcher harness resolution' \
            'The requested launcher harness is invalid.' \
            'The --harness or RHYOLITE_HARNESS value could not be resolved safely.' \
            'Pass --harness copilot, set RHYOLITE_HARNESS=copilot, or unset the environment override.' \
            2
    rhyolite_harness_validate_context "${harness}" ||
        fail \
            'launcher harness context' \
            'The inherited launcher harness context is invalid.' \
            "${RHYOLITE_HARNESS_ERROR_DETAIL:-The inherited launcher harness marker could not be validated.}" \
            'Retry from a fresh environment after unsetting RHYOLITE_LAUNCHER_HARNESS, or restart from the trusted launcher with the same supported harness selected in both contexts.' \
            2 \
            'NONE' \
            'The inherited launcher marker was rejected before Copilot, launcher state, or guided setup could start.'
    rhyolite_harness_load "${plugin_root}" "${harness}" ||
        fail \
            'launcher harness validation' \
            'The requested launcher harness is unavailable.' \
            "${RHYOLITE_HARNESS_ERROR_DETAIL:-Harness adapter '${harness}' could not be loaded from the packaged plugin.}" \
            'Use --harness copilot with a complete Rhyolite plugin installation.' \
            2

    if ! rhyolite_harness_capture \
        LAUNCHER_HARNESS_DISPLAY harness_display_name ||
        ! rhyolite_harness_capture harness_cli harness_cli_name; then
        fail \
            'launcher harness validation' \
            'The requested launcher harness metadata is unavailable.' \
            "${RHYOLITE_HARNESS_ERROR_DETAIL:-Harness metadata could not be resolved.}" \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2
    fi
    LAUNCHER_HARNESS="${harness}"
    case "${harness}" in
        copilot)
            copilot_path="$(command -v copilot || true)"
            [ -n "${copilot_path}" ] ||
                fail \
                    'Copilot CLI discovery' \
                    'The GitHub Copilot CLI is not available.' \
                    "The 'copilot' executable was not found on PATH." \
                    'Install GitHub Copilot CLI or add it to PATH, then retry.' \
                    127
            ;;
        claude)
            for required_claude_asset in \
                .claude-plugin/plugin.json \
                claude/agents/repo-review.md \
                claude/agents/repo-review-worker.md \
                claude/commands/start.md \
                claude/hooks.json; do
                [ -f "${plugin_root}/${required_claude_asset}" ] ||
                    fail \
                        'plugin validation' \
                        'A required Claude Code plugin asset is missing.' \
                        "${required_claude_asset} was not found under ${plugin_root}." \
                        'Restore the complete Rhyolite plugin installation and retry.' \
                        2
            done
            LAUNCHER_DEFAULT_MODEL="${RHYOLITE_CLAUDE_DEFAULT_MODEL}"
            LAUNCHER_MODEL_IDS=(
                "${RHYOLITE_CLAUDE_DEFAULT_MODEL}"
                "${RHYOLITE_CLAUDE_ALTERNATE_MODEL}"
            )
            LAUNCHER_MODEL_LABELS=(
                'Claude Opus 5.5 (Recommended)'
                'Claude Opus 5'
            )
            LAUNCHER_MODEL_IDS_HINT='rhyolite --harness claude model picker'
            copilot_path="$(command -v "${harness_cli}" || true)"
            [ -n "${copilot_path}" ] ||
                fail \
                    'Claude Code CLI discovery' \
                    'The Claude Code CLI is not available.' \
                    "The '${harness_cli}' executable was not found on PATH." \
                    'Install Claude Code or add it to PATH, then retry.' \
                    127
            ;;
        *)
            fail \
                'launcher harness validation' \
                'The requested launcher harness has no supported outer session.' \
                "Harness '${harness}' cannot start an interactive Rhyolite session." \
                'Use --harness copilot or --harness claude with a complete Rhyolite plugin installation.' \
                2
            ;;
    esac

    original_dir="$(pwd -P)"
    assert_control_free_path "${original_dir}"
    assert_control_free_path "${plugin_root}"

    launch_dir="$(get_clean_launch_dir "${original_dir}")"
    launch_dir="$(cd -P "${launch_dir}" && pwd)"
    assert_control_free_path "${launch_dir}"
    if contains_git_marker "${launch_dir}"; then
        fail \
            'clean launch directory selection' \
            'The selected orchestration directory is still a Git worktree.' \
            "Refusing to start inside ${launch_dir}." \
            'Start Rhyolite from a directory outside every Git worktree.' \
            2
    fi

    launcher_home="$(rhyolite_launcher_home)"
    session_dir="$(create_session_dir "${launcher_home}")"
    sweep_stale_model_check_homes "${launcher_home}/sessions"
    log_dir="${session_dir}/${harness}-logs"
    if [[ "${harness}" == copilot ]]; then
        mkdir -p "${log_dir}"
    fi

    initial_request="$(join_initial_request "${request_parts[@]}")"
    # Every repository URL on the command line is a source, whether it
    # follows --repo or appears in the initial review request.
    if [[ -n "${initial_request}" ]]; then
        while IFS= read -r repository; do
            repository_inputs+=("${repository}")
        done < <(extract_repository_urls_from_request "${initial_request}")
        request_has_non_url_text "${initial_request}" || initial_request=''
    fi
    if [[ -t 0 && -t 1 ]]; then
        is_interactive=1
    fi
    while [[ ${#repository_inputs[@]} -eq 0 ]]; do
        if ((is_interactive == 0)); then
            fail \
                'launcher guided setup' \
                'A public repository URL is required before automatic startup.' \
                'No --repo value or public HTTPS URL was found in the initial request.' \
                'Pass --repo URL, include the URL in the initial request, or run interactively.' \
                2
        fi
        printf 'Public repository URL(s), separated by commas or spaces: '
        IFS= read -r repository_input
        while IFS= read -r repository; do
            repository_inputs+=("${repository}")
        done < <(split_repository_input "${repository_input}")
    done

    for repository in "${repository_inputs[@]}"; do
        if ! rhyolite_canonicalize_repository "${repository}"; then
            invalid_repository="${repository}"
            break
        fi
        repository="${RHYOLITE_CANONICAL_REPOSITORY}"
        if github_account_without_repository "${repository}"; then
            fail \
                'launcher source validation' \
                'A GitHub URL names an account but no repository.' \
                "The URL has no repository name: ${repository}" \
                "Add the repository name, for example ${repository}/REPOSITORY, and retry." \
                2
        fi
        repository_key="$(repository_selection_key "${repository}")"
        duplicate=0
        for existing_repository in "${repositories[@]}"; do
            if [[ "$(repository_selection_key "${existing_repository}")" == \
                "${repository_key}" ]]; then
                duplicate=1
                break
            fi
        done
        ((duplicate == 0)) && repositories+=("${repository}")
    done
    [[ -z "${invalid_repository}" && ${#repositories[@]} -gt 0 ]] ||
        fail \
            'launcher source validation' \
            'The launcher rejected an unsafe repository source.' \
            "Only anonymous public HTTPS Git repository URLs are supported: ${invalid_repository:-NONE}" \
            'Correct the repository URL and retry.' \
            2

    for repository in "${repositories[@]}"; do
        if rhyolite_read_preference \
            "${repository}" "${harness}" "${launcher_home}"; then
            if [[ -z "${remembered_model}" ]]; then
                remembered_model="${RHYOLITE_PREFERENCE_MODEL}"
                remembered_reasoning_effort="${RHYOLITE_PREFERENCE_REASONING_EFFORT}"
                remembered_context_tier="${RHYOLITE_PREFERENCE_CONTEXT_TIER}"
            elif [[ "${remembered_model}" != "${RHYOLITE_PREFERENCE_MODEL}" ||
                "${remembered_reasoning_effort}" != "${RHYOLITE_PREFERENCE_REASONING_EFFORT}" ||
                "${remembered_context_tier}" != "${RHYOLITE_PREFERENCE_CONTEXT_TIER}" ]]; then
                remembered_consistent=0
            fi
        else
            preference_status="${RHYOLITE_PREFERENCE_STATUS}"
            if [[ "${preference_status}" == invalid ]]; then
                printf 'Rhyolite launcher ignored an invalid saved preference for %s.\n' \
                    "${repository}" >&2
            fi
            remembered_consistent=0
        fi
    done
    if ((remembered_consistent == 0)); then
        remembered_model=''
        remembered_reasoning_effort=''
        remembered_context_tier=''
    fi

    if [[ -n "${remembered_model}" ]] &&
        ! launcher_model_accepted \
            "${remembered_model}" "${allow_unlisted_model}"; then
        if launcher_model_unlisted; then
            printf 'Rhyolite launcher ignored saved settings because model %s is not in the offline %s model catalog; pass --allow-unlisted-model to reuse it.\n' \
                "${remembered_model}" "${LAUNCHER_HARNESS_DISPLAY}" >&2
        else
            printf 'Rhyolite launcher ignored saved settings because model %s is no longer available.\n' \
                "${remembered_model}" >&2
        fi
        remembered_model=''
        remembered_reasoning_effort=''
        remembered_context_tier=''
    fi
    if [[ -n "${model}" ]] &&
        ! launcher_model_accepted "${model}" "${allow_unlisted_model}"; then
        if launcher_model_unlisted; then
            fail \
                'launcher model validation' \
                "The requested model is not in ${LAUNCHER_HARNESS_DISPLAY}'s offline model catalog." \
                "${RHYOLITE_HARNESS_ERROR_DETAIL:-The selected model was not present in the ${LAUNCHER_HARNESS_DISPLAY} model catalog.}" \
                "Pass --allow-unlisted-model with this exact model ID so ${LAUNCHER_HARNESS_DISPLAY} verifies it when the review runs, or pass one of the IDs shown by ${LAUNCHER_MODEL_IDS_HINT}." \
                2
        fi
        fail \
            'launcher model validation' \
            'The requested model is not available.' \
            "${RHYOLITE_HARNESS_ERROR_DETAIL:-The selected model was not present in the ${LAUNCHER_HARNESS_DISPLAY} model catalog.}" \
            "Run the launcher interactively and choose List available model IDs, or pass one of the IDs shown by ${LAUNCHER_MODEL_IDS_HINT}." \
            2
    fi

    if [[ -z "${model}" ]]; then
        if ((is_interactive)); then
            model="$(
                prompt_for_model \
                    "${remembered_model}" "${allow_unlisted_model}"
            )"
        else
            model="${remembered_model:-${LAUNCHER_DEFAULT_MODEL}}"
        fi
    fi
    if ! launcher_model_accepted "${model}" "${allow_unlisted_model}"; then
        fail \
            'launcher model validation' \
            'The selected model is not available.' \
            "${RHYOLITE_HARNESS_ERROR_DETAIL:-The selected model was not present in the ${LAUNCHER_HARNESS_DISPLAY} model catalog.}" \
            'Choose another model from the available catalog and retry.' \
            2
    fi
    if [[ -z "${reasoning_effort}" ]]; then
        if ((is_interactive)); then
            reasoning_effort="$(
                prompt_for_reasoning_effort \
                    "${remembered_reasoning_effort}"
            )"
        else
            reasoning_effort="${remembered_reasoning_effort:-${RHYOLITE_DEFAULT_REASONING_EFFORT}}"
        fi
    fi
    rhyolite_harness_invoke \
        harness_validate_reasoning_effort \
        "${reasoning_effort}" >/dev/null 2>&1 ||
        fail \
            'launcher reasoning-effort validation' \
            'The selected reasoning effort is unsupported.' \
            "${RHYOLITE_HARNESS_ERROR_DETAIL:-The selected harness rejected the reasoning effort.}" \
            'Choose high, xhigh, or max and retry.' \
            2
    if [[ -z "${context_tier}" ]]; then
        if ((is_interactive)); then
            context_tier="$(
                prompt_for_context_tier "${remembered_context_tier}"
            )"
        else
            context_tier="${remembered_context_tier:-${RHYOLITE_DEFAULT_CONTEXT_TIER}}"
        fi
    fi
    rhyolite_harness_invoke \
        harness_validate_context_tier "${context_tier}" >/dev/null 2>&1 ||
        fail \
            'launcher context-tier validation' \
            'The selected context tier is unsupported.' \
            "${RHYOLITE_HARNESS_ERROR_DETAIL:-The selected harness rejected the context tier.}" \
            'Choose default or long_context and retry.' \
            2

    if ((is_interactive)); then
        while true; do
            confirmation_action="$(
                prompt_to_confirm_runtime_settings \
                    "${harness}" \
                    "${model}" \
                    "${reasoning_effort}" \
                    "${context_tier}"
            )"
            case "${confirmation_action}" in
                confirm) break ;;
                model)
                    model="$(
                        prompt_for_model "${model}" "${allow_unlisted_model}"
                    )"
                    ;;
                effort)
                    reasoning_effort="$(
                        prompt_for_reasoning_effort "${reasoning_effort}"
                    )"
                    ;;
                context)
                    context_tier="$(
                        prompt_for_context_tier "${context_tier}"
                    )"
                    ;;
                *)
                    printf 'Enter one of the displayed choice numbers.\n' >&2
                    ;;
            esac
        done
    fi

    if [[ "${harness}" == copilot ]]; then
        LAUNCHER_ACCESS_MODEL="${model}"
        LAUNCHER_ACCESS_EFFORT="${reasoning_effort}"
        model_access_status=0
        ensure_copilot_model_access \
            "${copilot_path}" \
            "${context_tier}" \
            "${is_interactive}" \
            "${allow_unlisted_model}" \
            "${session_dir}" || model_access_status=$?
        if ((model_access_status == 3)); then
            printf '%s\n' 'Rhyolite did not start Copilot.' >&2
            return 0
        fi
        model="${LAUNCHER_ACCESS_MODEL}"
        reasoning_effort="${LAUNCHER_ACCESS_EFFORT}"
    fi

    initial_prompt="$(
        build_initial_prompt \
            "${initial_request}" \
            "${model}" \
            "${reasoning_effort}" \
            "${context_tier}" \
            "${allow_unlisted_model}" \
            "${repositories[@]}"
    )"
    write_launch_context \
        "${session_dir}/launch-context.txt" \
        "${version}" \
        "${original_dir}" \
        "${launch_dir}" \
        "${plugin_root}" \
        "${model}" \
        "${reasoning_effort}" \
        "${context_tier}" \
        "${allow_unlisted_model}"

    export RHYOLITE_LAUNCHER_CALLER_DIR="${original_dir}"
    export RHYOLITE_LAUNCHER_LAUNCH_DIR="${launch_dir}"
    export RHYOLITE_LAUNCHER_PLUGIN_ROOT="${plugin_root}"
    export RHYOLITE_LAUNCHER_HARNESS="${harness}"
    export RHYOLITE_LAUNCHER_SESSION_DIR="${session_dir}"
    export RHYOLITE_LAUNCHER_VERSION="${version}"
    export RHYOLITE_LAUNCHER_IMMEDIATE_START="${RHYOLITE_LAUNCHER_IMMEDIATE_START_MARKER}"
    export RHYOLITE_LAUNCHER_MODEL="${model}"
    export RHYOLITE_LAUNCHER_REASONING_EFFORT="${reasoning_effort}"
    export RHYOLITE_LAUNCHER_CONTEXT_TIER="${context_tier}"

    if [[ "${harness}" == claude ]]; then
        escaped_plugin_root="${plugin_root//\\/\\\\}"
        escaped_plugin_root="${escaped_plugin_root//\"/\\\"}"
        claude_settings="$(
            printf '{"permissions":{"allow":["Bash(bash %s/skills/readonly-repository-review/scripts/run-parallel-reviews.sh *)"]}}' \
                "${escaped_plugin_root}"
        )"
        # Claude Code renders the startup plaque after the first visible
        # prompt, so the trusted setup block travels in the system prompt and
        # the visible prompt stays two lines long.
        claude_setup_block="$(
            build_launcher_setup_block \
                "${model}" \
                "${reasoning_effort}" \
                "${context_tier}" \
                "${allow_unlisted_model}" \
                "${repositories[@]}"
        )"
        claude_start_prompt="$(
            printf '%s\n' "${RHYOLITE_START_MARKER}"
            build_start_request "${initial_request}"
        )"
        claude_arguments=(
            --plugin-dir "${plugin_root}"
            --agent "${RHYOLITE_AGENT}"
            --model "${model}"
            --effort "${reasoning_effort}"
            --name "rhyolite-$(basename "${session_dir}")"
            --strict-mcp-config
            --settings "${claude_settings}"
            --permission-mode default
            --append-system-prompt "${claude_setup_block}"
        )
        if ((yolo)); then
            claude_arguments=(--dangerously-skip-permissions "${claude_arguments[@]}")
        fi
        set +e
        (
            cd "${launch_dir}" &&
                "${copilot_path}" "${claude_arguments[@]}" -- "${claude_start_prompt}"
        )
        copilot_exit_code=$?
        set -e
        if [ "${copilot_exit_code}" -ne 0 ]; then
            fail \
                'Claude Code session' \
                'The Claude Code session exited before Rhyolite completed normally.' \
                "Claude Code returned exit code ${copilot_exit_code}." \
                'Address the reported Claude Code failure and retry from a clean non-Git directory.' \
                "${copilot_exit_code}" \
                "${session_dir}/launch-context.txt" \
                'Claude Code and guided repository-review setup did not start or complete.'
        fi
        return 0
    fi

    copilot_arguments=(
        --experimental
        -C "${launch_dir}"
        --plugin-dir "${plugin_root}"
        --mode interactive
        --agent "${RHYOLITE_AGENT}"
        --model "${model}"
        --reasoning-effort "${reasoning_effort}"
        --context "${context_tier}"
        --log-dir "${log_dir}"
        --no-custom-instructions
        -i "${initial_prompt}"
    )
    if ((yolo)); then
        copilot_arguments=(--yolo "${copilot_arguments[@]}")
    fi
    set +e
    "${copilot_path}" "${copilot_arguments[@]}"
    copilot_exit_code=$?
    set -e
    if [ "${copilot_exit_code}" -ne 0 ]; then
        fail \
            'Copilot session' \
            'The Copilot CLI session exited before Rhyolite completed normally.' \
            "Copilot CLI returned exit code ${copilot_exit_code}." \
            'Review the launcher logs, address the reported Copilot failure, and retry from a clean non-Git directory.' \
            "${copilot_exit_code}" \
            "${session_dir}/launch-context.txt; ${log_dir}"
    fi
}

main "$@"
