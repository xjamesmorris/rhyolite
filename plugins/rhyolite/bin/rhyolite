#!/usr/bin/env bash

set -euo pipefail
umask 077

readonly RHYOLITE_AGENT='rhyolite:repo-review'
readonly RHYOLITE_START_MARKER='RHYOLITE_START_COMMAND_V1'
readonly RHYOLITE_LAUNCHER_IMMEDIATE_START_MARKER='RHYOLITE_LAUNCHER_IMMEDIATE_START_V1'
readonly RHYOLITE_LAUNCHER_SETUP_MARKER='RHYOLITE_LAUNCHER_SETUP_V1'
readonly RHYOLITE_DEFAULT_MODEL='gpt-5.6-sol'
readonly RHYOLITE_ALTERNATE_MODEL='claude-fable-5'
readonly RHYOLITE_REASONING_EFFORT='max'
RHYOLITE_SUPPORT_TEXT='SUPPORT.md and local documentation'
RHYOLITE_CONTRIBUTE_TEXT='CONTRIBUTING.md'

fail() {
    local stage="$1"
    local summary="$2"
    local details="$3"
    local remediation="$4"
    local exit_code="${5:-1}"
    local artifacts="${6:-NONE}"
    local safe_details

    safe_details="$(
        printf '%s' "${details}" |
            LC_ALL=C tr -d '\000-\010\013-\037\177' |
            sed -E \
                -e 's#(https?://)[^/@[:space:]]+:[^/@[:space:]]+@#\1[credentials omitted]@#g' \
                -e 's/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/[email omitted]/g' \
                -e 's/((Authorization|authorization|Proxy-Authorization|proxy-authorization):[[:space:]]*)((Bearer|bearer|Basic|basic)[[:space:]]+)?[^[:space:]]+/\1[credential omitted]/g' \
                -e 's/(access[_-]?token|api[_-]?key|password|secret|token)[[:space:]]*[:=][[:space:]]*[^[:space:]]+/\1=[credential omitted]/g' \
                -e 's/(github_pat_|gh[pousr]_)[A-Za-z0-9_]{20,}/[credential omitted]/g' |
            tr '\r\n' '  '
    )"
    [ -n "${safe_details}" ] ||
        safe_details='No additional safe detail was returned.'

    printf '%s\n' \
        'RHYOLITE ERROR' \
        "Summary: ${summary}" \
        "Stage: ${stage}" \
        'Source: NOT APPLICABLE' \
        "Details: ${safe_details} (exit code ${exit_code})" \
        'Consequence: Copilot and guided repository-review setup did not start or complete.' \
        "Remediation: ${remediation}" \
        "Artifacts: ${artifacts}" \
        "Support: ${RHYOLITE_SUPPORT_TEXT}" \
        "Contribute: ${RHYOLITE_CONTRIBUTE_TEXT}" >&2
    exit "${exit_code}"
}

configure_repository_links() {
    local plugin_root="$1"
    local metadata_path="${plugin_root}/branding/welcome-metadata.json"
    local home_url docs_url support_url issues_url pulls_url
    local value

    [ -f "${metadata_path}" ] || return 0
    home_url="$(
        sed -n 's/^[[:space:]]*"homeUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    docs_url="$(
        sed -n 's/^[[:space:]]*"docsUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    support_url="$(
        sed -n 's/^[[:space:]]*"supportUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    issues_url="$(
        sed -n 's/^[[:space:]]*"issuesUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    pulls_url="$(
        sed -n 's/^[[:space:]]*"pullsUrl"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${metadata_path}" | head -n 1
    )"
    for value in \
        "${home_url}" \
        "${docs_url}" \
        "${support_url}" \
        "${issues_url}" \
        "${pulls_url}"; do
        case "${value}" in
            ''|*'<PUBLIC_'*'>'*) return 0 ;;
        esac
    done
    RHYOLITE_SUPPORT_TEXT="${issues_url}"
    RHYOLITE_CONTRIBUTE_TEXT="${pulls_url}"
}

unexpected_launcher_error() {
    local exit_code="$1"
    local line_number="$2"
    trap - ERR
    fail \
        'launcher runtime' \
        'The launcher encountered an unexpected local setup failure.' \
        "A local launcher operation failed near line ${line_number}." \
        'Correct the preceding path, permission, or installation error and retry.' \
        "${exit_code}"
}

trap 'unexpected_launcher_error "$?" "${LINENO}"' ERR

resolve_physical_path() {
    local path="$1"
    local dir
    local target
    local symlink_hops=0

    case "${path}" in
        /*) ;;
        *) path="${PWD%/}/${path}" ;;
    esac

    while [ -L "${path}" ]; do
        symlink_hops=$((symlink_hops + 1))
        [ "${symlink_hops}" -le 40 ] ||
            fail \
                'launcher path resolution' \
                'The launcher path could not be resolved safely.' \
                "Too many symlink levels while resolving ${path}." \
                'Remove the symlink loop or invoke the packaged launcher from its physical path.' \
                2
        dir="$(cd -P "$(dirname "${path}")" && pwd)"
        target="$(readlink "${path}")" ||
            fail \
                'launcher path resolution' \
                'The launcher symlink could not be read.' \
                "Could not resolve symlink ${path}." \
                'Repair the symlink or invoke the packaged launcher from its physical path.' \
                2
        case "${target}" in
            /*) path="${target}" ;;
            *) path="${dir}/${target}" ;;
        esac
    done

    dir="$(cd -P "$(dirname "${path}")" && pwd)"
    printf '%s/%s\n' "${dir}" "$(basename "${path}")"
}

strip_control_chars() {
    printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177'
}

read_plugin_version() {
    local plugin_root="$1"
    local version

    version="$(
        sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${plugin_root}/plugin.json" | head -n 1
    )"
    [ -n "${version}" ] ||
        fail \
            'plugin validation' \
            'The installed plugin version is unavailable.' \
            "Could not read version from ${plugin_root}/plugin.json." \
            'Restore a valid plugin.json, then retry the launcher.' \
            2
    printf '%s\n' "${version}"
}

get_launcher_home() {
    if [ -n "${XDG_STATE_HOME:-}" ]; then
        case "${XDG_STATE_HOME}" in
            /*)
                printf '%s/rhyolite/launcher\n' "${XDG_STATE_HOME%/}"
                return
                ;;
        esac
    fi

    case "$(uname -s 2>/dev/null || printf 'unknown')" in
        Darwin)
            printf '%s/Library/Application Support/Rhyolite/Launcher\n' \
                "${HOME%/}"
            ;;
        *)
            printf '%s/.local/state/rhyolite/launcher\n' "${HOME%/}"
            ;;
    esac
}

contains_git_marker() {
    [ -e "$1/.git" ]
}

get_clean_launch_dir() {
    local original_dir="$1"
    local cursor="${original_dir}"
    local last_git_root=""
    local parent

    while true; do
        if contains_git_marker "${cursor}"; then
            last_git_root="${cursor}"
        fi
        parent="$(dirname "${cursor}")"
        [ "${parent}" != "${cursor}" ] || break
        cursor="${parent}"
    done

    if [ -n "${last_git_root}" ]; then
        parent="$(dirname "${last_git_root}")"
        [ "${parent}" != "${last_git_root}" ] ||
            fail \
                'clean launch directory selection' \
                'A safe non-Git launch directory could not be derived.' \
                "The Git worktree root ${last_git_root} has no usable parent directory." \
                'Run the launcher from a normal filesystem location outside the target worktree.' \
                2
        printf '%s\n' "${parent}"
        return
    fi

    printf '%s\n' "${original_dir}"
}

assert_control_free_path() {
    case "$1" in
        *[$'\001'$'\002'$'\003'$'\004'$'\005'$'\006'$'\007'$'\010'$'\011'$'\012'$'\013'$'\014'$'\015'$'\016'$'\017'$'\020'$'\021'$'\022'$'\023'$'\024'$'\025'$'\026'$'\027'$'\030'$'\031'$'\032'$'\033'$'\034'$'\035'$'\036'$'\037'$'\177']*)
            fail \
                'launcher path validation' \
                'A required launcher path contains control characters.' \
                "Rejected path: $1" \
                'Move the checkout or working directory to a control-free path and retry.' \
                2
            ;;
    esac
}

create_session_dir() {
    local base_dir="$1"
    local timestamp
    local attempt=0
    local session_id
    local session_dir

    mkdir -p "${base_dir}/sessions"
    chmod 700 "${base_dir}" "${base_dir}/sessions" ||
        fail \
            'launcher state creation' \
            'Launcher state could not be restricted to the current user.' \
            "Could not secure launcher state under ${base_dir}." \
            'Choose a writable user-owned state directory and retry.' \
            2 \
            "${base_dir}"

    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    while true; do
        session_id="${timestamp}-$$"
        if [ "${attempt}" -gt 0 ]; then
            session_id="${session_id}-${attempt}"
        fi
        session_dir="${base_dir}/sessions/${session_id}"
        if mkdir "${session_dir}" 2>/dev/null; then
            printf '%s\n' "${session_dir}"
            return
        fi
        [ -e "${session_dir}" ] ||
            fail \
                'launcher state creation' \
                'A unique launcher session directory could not be created.' \
                "Could not create ${session_dir}." \
                'Check available space and permissions under the launcher state directory, then retry.' \
                2 \
                "${base_dir}"
        attempt=$((attempt + 1))
    done
}

join_initial_request() {
    local joined=''
    local part
    local sanitized

    for part in "$@"; do
        sanitized="$(strip_control_chars "${part}")"
        case "${sanitized}" in
            *[![:space:]]*) ;;
            *) continue ;;
        esac
        if [ -n "${joined}" ]; then
            joined="${joined} ${sanitized}"
        else
            joined="${sanitized}"
        fi
    done

    printf '%s' "${joined}"
}

extract_repository_urls_from_request() {
    local request="$1"
    local token

    for token in ${request}; do
        case "${token}" in
            https://*|HTTPS://*)
                token="${token%,}"
                token="${token%;}"
                token="${token%.}"
                token="${token%)}"
                token="${token%]}"
                printf '%s\n' "${token}"
                ;;
        esac
    done
}

split_repository_input() {
    printf '%s\n' "$1" |
        tr ',' '\n' |
        while IFS= read -r value; do
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"
            [[ -n "${value}" ]] && printf '%s\n' "${value}"
        done
}

prompt_for_fleet_mode() {
    local remembered_mode="$1"
    local answer

    while true; do
        printf '\nRhyolite execution mode\n' >&2
        if [[ -n "${remembered_mode}" ]]; then
            printf '  1. Keep previously used (%s)\n' \
                "${remembered_mode}" >&2
            printf '  2. Native Copilot fleet mode\n' >&2
            printf '  3. Standard Copilot mode\n' >&2
            printf 'Select mode [1]: ' >&2
            IFS= read -r answer
            case "${answer:-1}" in
                1) printf '%s\n' "${remembered_mode}"; return ;;
                2) printf '%s\n' native; return ;;
                3) printf '%s\n' standard; return ;;
            esac
        else
            printf '  1. Standard Copilot mode\n' >&2
            printf '  2. Native Copilot fleet mode\n' >&2
            printf 'Select mode [1]: ' >&2
            IFS= read -r answer
            case "${answer:-1}" in
                1) printf '%s\n' standard; return ;;
                2) printf '%s\n' native; return ;;
            esac
        fi
        printf 'Enter one of the displayed choice numbers.\n' >&2
    done
}

prompt_for_model() {
    local remembered_model="$1"
    local answer custom_model

    while true; do
        printf '\nReview model\n' >&2
        if [[ -n "${remembered_model}" ]]; then
            printf '  1. Keep previously used (%s)\n' \
                "${remembered_model}" >&2
            printf '  2. GPT-5.6 Sol (%s)\n' \
                "${RHYOLITE_DEFAULT_MODEL}" >&2
            printf '  3. Claude Fable 5 (%s)\n' \
                "${RHYOLITE_ALTERNATE_MODEL}" >&2
            printf '  4. Enter another frontier model ID\n' >&2
            printf 'Select model [1]: ' >&2
            IFS= read -r answer
            case "${answer:-1}" in
                1) printf '%s\n' "${remembered_model}"; return ;;
                2) printf '%s\n' "${RHYOLITE_DEFAULT_MODEL}"; return ;;
                3) printf '%s\n' "${RHYOLITE_ALTERNATE_MODEL}"; return ;;
                4) ;;
                *) printf 'Enter one of the displayed choice numbers.\n' >&2; continue ;;
            esac
        else
            printf '  1. GPT-5.6 Sol (%s)\n' \
                "${RHYOLITE_DEFAULT_MODEL}" >&2
            printf '  2. Claude Fable 5 (%s)\n' \
                "${RHYOLITE_ALTERNATE_MODEL}" >&2
            printf '  3. Enter another frontier model ID\n' >&2
            printf 'Select model [1]: ' >&2
            IFS= read -r answer
            case "${answer:-1}" in
                1) printf '%s\n' "${RHYOLITE_DEFAULT_MODEL}"; return ;;
                2) printf '%s\n' "${RHYOLITE_ALTERNATE_MODEL}"; return ;;
                3) ;;
                *) printf 'Enter one of the displayed choice numbers.\n' >&2; continue ;;
            esac
        fi

        printf 'Frontier model ID: ' >&2
        IFS= read -r custom_model
        if rhyolite_valid_model_id "${custom_model}"; then
            printf '%s\n' "${custom_model}"
            return
        fi
        printf 'Model IDs may contain only letters, numbers, dots, underscores, and hyphens.\n' >&2
    done
}

build_initial_prompt() {
    local initial_request="$1"
    local fleet_mode="$2"
    local model="$3"
    shift 3
    local repository

    printf '%s\n%s\n' \
        "${RHYOLITE_START_MARKER}" \
        "${RHYOLITE_LAUNCHER_SETUP_MARKER}"
    for repository in "$@"; do
        printf 'Source=%s\n' "${repository}"
    done
    printf 'FleetMode=%s\n' "${fleet_mode}"
    printf 'Model=%s\n' "${model}"
    printf 'RememberPreferences=true\n'
    printf 'END_%s\n' "${RHYOLITE_LAUNCHER_SETUP_MARKER}"
    printf "Begin Rhyolite's guided repository-review setup now."
    if [ -n "${initial_request}" ]; then
        printf "\nTreat the following text as the user's initial review request:\n\n%s" \
            "${initial_request}"
    fi
}

write_launch_context() {
    local context_path="$1"
    local version="$2"
    local original_dir="$3"
    local launch_dir="$4"
    local plugin_root="$5"
    local fleet_mode="$6"
    local model="$7"

    {
        printf 'StartedAtUtc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'Version=%s\n' "${version}"
        printf 'OriginalWorkingDirectory=%s\n' "${original_dir}"
        printf 'LaunchDirectory=%s\n' "${launch_dir}"
        printf 'PluginRoot=%s\n' "${plugin_root}"
        printf 'FleetMode=%s\n' "${fleet_mode}"
        printf 'Model=%s\n' "${model}"
        printf 'RememberPreferences=true\n'
    } > "${context_path}"
}

print_help() {
    local version="$1"

    cat <<EOF
Rhyolite launcher v${version}

Usage:
  rhyolite [--help]
  rhyolite [--version]
  rhyolite [--repo URL ...] [--fleet-mode native|standard]
           [--model MODEL] [--yolo] [--autopilot]
           [--] [initial review request...]

Options:
  --yolo       Start Copilot in YOLO mode for this launch.
  --autopilot  Start Copilot in autopilot mode for this launch.

Starts Copilot outside Git worktrees with the checkout-loaded Rhyolite plugin,
collects launcher settings, selects ${RHYOLITE_AGENT}, and begins guided setup
immediately. Approved fleet/model settings are remembered per repository.
EOF
}

main() {
    local script_path
    local script_dir
    local plugin_root
    local version
    local mode='launch'
    local original_dir
    local launch_dir
    local launcher_home
    local session_dir
    local log_dir
    local initial_request
    local initial_prompt
    local fleet_mode=''
    local model=''
    local yolo=0
    local autopilot=0
    local remembered_fleet_mode=''
    local remembered_model=''
    local remembered_consistent=1
    local preference_status
    local repository_input
    local repository
    local existing_repository
    local duplicate
    local invalid_repository=''
    local is_interactive=0
    local copilot_path
    local copilot_exit_code
    local preferences_helper
    local -a request_parts=()
    local -a repository_inputs=()
    local -a repositories=()
    local -a copilot_arguments=()

    script_path="$(resolve_physical_path "${BASH_SOURCE[0]}")"
    script_dir="$(cd -P "$(dirname "${script_path}")" && pwd)"
    plugin_root="$(cd -P "${script_dir}/.." && pwd)"
    configure_repository_links "${plugin_root}"

    [ -f "${plugin_root}/plugin.json" ] ||
        fail \
            'plugin validation' \
            'Required plugin metadata is missing.' \
            "Plugin metadata was not found under ${plugin_root}." \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2
    [ -f "${plugin_root}/commands/start.md" ] ||
        fail \
            'plugin validation' \
            'The Rhyolite start command is missing.' \
            "Start command was not found under ${plugin_root}." \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2
    [ -f "${plugin_root}/agents/repo-review.agent.md" ] ||
        fail \
            'plugin validation' \
            'The Rhyolite review agent is missing.' \
            "Repo-review agent was not found under ${plugin_root}." \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2

    preferences_helper="${plugin_root}/scripts/launcher-preferences.sh"
    [ -f "${preferences_helper}" ] ||
        fail \
            'launcher preference validation' \
            'The launcher preference helper is missing.' \
            "Preference helper was not found at ${preferences_helper}." \
            'Restore the complete Rhyolite plugin installation and retry.' \
            2
    # shellcheck source=../scripts/launcher-preferences.sh
    source "${preferences_helper}"

    version="$(read_plugin_version "${plugin_root}")"

    if [ "$#" -gt 0 ]; then
        case "$1" in
            --help|-h)
                mode='help'
                shift
                ;;
            --version|-v)
                mode='version'
                shift
                ;;
        esac
    fi

    if [ "${mode}" = 'help' ]; then
        [ "$#" -eq 0 ] ||
            fail \
                'launcher argument validation' \
                'The help request included unsupported extra arguments.' \
                '--help does not accept additional arguments.' \
                'Run rhyolite --help without any other arguments.' \
                2
        print_help "${version}"
        exit 0
    fi

    if [ "${mode}" = 'version' ]; then
        [ "$#" -eq 0 ] ||
            fail \
                'launcher argument validation' \
                'The version request included unsupported extra arguments.' \
                '--version does not accept additional arguments.' \
                'Run rhyolite --version without any other arguments.' \
                2
        printf 'Rhyolite v%s\n' "${version}"
        exit 0
    fi

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo)
                [ "$#" -ge 2 ] && [ -n "$2" ] ||
                    fail \
                        'launcher argument validation' \
                        'A repository URL argument is missing.' \
                        '--repo requires a public HTTPS Git repository URL.' \
                        'Pass --repo URL or omit it to use interactive launcher setup.' \
                        2
                repository_inputs+=("$2")
                shift 2
                ;;
            --fleet-mode)
                [ "$#" -ge 2 ] ||
                    fail \
                        'launcher argument validation' \
                        'A fleet mode argument is missing.' \
                        '--fleet-mode requires native or standard.' \
                        'Pass --fleet-mode native or --fleet-mode standard.' \
                        2
                case "$2" in
                    native|standard) fleet_mode="$2" ;;
                    *)
                        fail \
                            'launcher argument validation' \
                            'The requested fleet mode is invalid.' \
                            "Unsupported fleet mode: $2" \
                            'Pass --fleet-mode native or --fleet-mode standard.' \
                            2
                        ;;
                esac
                shift 2
                ;;
            --model)
                [ "$#" -ge 2 ] && rhyolite_valid_model_id "$2" ||
                    fail \
                        'launcher argument validation' \
                        'The requested model identifier is invalid.' \
                        '--model requires a safe Copilot model identifier.' \
                        'Use letters, numbers, dots, underscores, and hyphens only.' \
                        2
                model="$2"
                shift 2
                ;;
            --yolo)
                yolo=1
                shift
                ;;
            --autopilot)
                autopilot=1
                shift
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    request_parts+=("$1")
                    shift
                done
                ;;
            *)
                request_parts+=("$1")
                shift
                ;;
        esac
    done

    copilot_path="$(command -v copilot || true)"
    [ -n "${copilot_path}" ] ||
        fail \
            'Copilot CLI discovery' \
            'The GitHub Copilot CLI is not available.' \
            "The 'copilot' executable was not found on PATH." \
            'Install GitHub Copilot CLI or add it to PATH, then retry.' \
            127

    original_dir="$(pwd -P)"
    assert_control_free_path "${original_dir}"
    assert_control_free_path "${plugin_root}"

    launch_dir="$(get_clean_launch_dir "${original_dir}")"
    launch_dir="$(cd -P "${launch_dir}" && pwd)"
    assert_control_free_path "${launch_dir}"
    if contains_git_marker "${launch_dir}"; then
        fail \
            'clean launch directory selection' \
            'The selected orchestration directory is still a Git worktree.' \
            "Refusing to start inside ${launch_dir}." \
            'Start Rhyolite from a directory outside every Git worktree.' \
            2
    fi

    launcher_home="$(get_launcher_home)"
    session_dir="$(create_session_dir "${launcher_home}")"
    log_dir="${session_dir}/copilot-logs"
    mkdir -p "${log_dir}"

    initial_request="$(join_initial_request "${request_parts[@]}")"
    if [[ ${#repository_inputs[@]} -eq 0 && -n "${initial_request}" ]]; then
        while IFS= read -r repository; do
            [[ -n "${repository}" ]] && repository_inputs+=("${repository}")
        done < <(extract_repository_urls_from_request "${initial_request}")
    fi
    if [[ -t 0 && -t 1 ]]; then
        is_interactive=1
    fi
    while [[ ${#repository_inputs[@]} -eq 0 ]]; do
        if ((is_interactive == 0)); then
            fail \
                'launcher guided setup' \
                'A public repository URL is required before automatic startup.' \
                'No --repo value or public HTTPS URL was found in the initial request.' \
                'Pass --repo URL, include the URL in the initial request, or run interactively.' \
                2
        fi
        printf 'Public repository URL(s), comma-separated: '
        IFS= read -r repository_input
        while IFS= read -r repository; do
            [[ -n "${repository}" ]] && repository_inputs+=("${repository}")
        done < <(split_repository_input "${repository_input}")
    done

    for repository in "${repository_inputs[@]}"; do
        if ! rhyolite_canonicalize_repository "${repository}"; then
            invalid_repository="${repository}"
            break
        fi
        repository="${RHYOLITE_CANONICAL_REPOSITORY}"
        duplicate=0
        for existing_repository in "${repositories[@]}"; do
            if [[ "${existing_repository}" == "${repository}" ]]; then
                duplicate=1
                break
            fi
        done
        ((duplicate == 0)) && repositories+=("${repository}")
    done
    [[ -z "${invalid_repository}" && ${#repositories[@]} -gt 0 ]] ||
        fail \
            'launcher source validation' \
            'The launcher rejected an unsafe repository source.' \
            "Only anonymous public HTTPS Git repository URLs are supported: ${invalid_repository:-NONE}" \
            'Correct the repository URL and retry.' \
            2

    for repository in "${repositories[@]}"; do
        if rhyolite_read_preference "${repository}" "${launcher_home}"; then
            if [[ -z "${remembered_fleet_mode}" ]]; then
                remembered_fleet_mode="${RHYOLITE_PREFERENCE_FLEET_MODE}"
                remembered_model="${RHYOLITE_PREFERENCE_MODEL}"
            elif [[ "${remembered_fleet_mode}" != "${RHYOLITE_PREFERENCE_FLEET_MODE}" ||
                "${remembered_model}" != "${RHYOLITE_PREFERENCE_MODEL}" ]]; then
                remembered_consistent=0
            fi
        else
            preference_status="${RHYOLITE_PREFERENCE_STATUS}"
            if [[ "${preference_status}" == invalid ]]; then
                printf 'Rhyolite launcher ignored an invalid saved preference for %s.\n' \
                    "${repository}" >&2
            fi
            remembered_consistent=0
        fi
    done
    if ((remembered_consistent == 0)); then
        remembered_fleet_mode=''
        remembered_model=''
    fi

    if [[ -z "${fleet_mode}" ]]; then
        if ((is_interactive)); then
            fleet_mode="$(
                prompt_for_fleet_mode "${remembered_fleet_mode}"
            )"
        else
            fleet_mode="${remembered_fleet_mode:-standard}"
        fi
    fi
    if [[ -z "${model}" ]]; then
        if ((is_interactive)); then
            model="$(prompt_for_model "${remembered_model}")"
        else
            model="${remembered_model:-${RHYOLITE_DEFAULT_MODEL}}"
        fi
    fi

    initial_prompt="$(
        build_initial_prompt \
            "${initial_request}" \
            "${fleet_mode}" \
            "${model}" \
            "${repositories[@]}"
    )"
    write_launch_context \
        "${session_dir}/launch-context.txt" \
        "${version}" \
        "${original_dir}" \
        "${launch_dir}" \
        "${plugin_root}" \
        "${fleet_mode}" \
        "${model}"

    export RHYOLITE_LAUNCHER_CALLER_DIR="${original_dir}"
    export RHYOLITE_LAUNCHER_LAUNCH_DIR="${launch_dir}"
    export RHYOLITE_LAUNCHER_PLUGIN_ROOT="${plugin_root}"
    export RHYOLITE_LAUNCHER_SESSION_DIR="${session_dir}"
    export RHYOLITE_LAUNCHER_VERSION="${version}"
    export RHYOLITE_LAUNCHER_IMMEDIATE_START="${RHYOLITE_LAUNCHER_IMMEDIATE_START_MARKER}"
    export RHYOLITE_LAUNCHER_FLEET_MODE="${fleet_mode}"
    export RHYOLITE_LAUNCHER_MODEL="${model}"

    copilot_arguments=(
        --experimental
        -C "${launch_dir}"
        --plugin-dir "${plugin_root}"
        --agent "${RHYOLITE_AGENT}"
        --model "${model}"
        --reasoning-effort "${RHYOLITE_REASONING_EFFORT}"
        --context long_context
        --log-dir "${log_dir}"
        --no-custom-instructions
        -i "${initial_prompt}"
    )
    if ((autopilot)); then
        copilot_arguments=(--autopilot "${copilot_arguments[@]}")
    fi
    if ((yolo)); then
        copilot_arguments=(--yolo "${copilot_arguments[@]}")
    fi
    if [[ "${fleet_mode}" == native ]]; then
        copilot_arguments=(--fleet "${copilot_arguments[@]}")
    fi
    set +e
    "${copilot_path}" "${copilot_arguments[@]}"
    copilot_exit_code=$?
    set -e
    if [ "${copilot_exit_code}" -ne 0 ]; then
        fail \
            'Copilot session' \
            'The Copilot CLI session exited before Rhyolite completed normally.' \
            "Copilot CLI returned exit code ${copilot_exit_code}." \
            'Review the launcher logs, address the reported Copilot failure, and retry from a clean non-Git directory.' \
            "${copilot_exit_code}" \
            "${session_dir}/launch-context.txt; ${log_dir}"
    fi
}

main "$@"
