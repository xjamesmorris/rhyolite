{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash \"$COPILOT_PLUGIN_ROOT/scripts/show-welcome-panel.sh\" --progress",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "bash \"$COPILOT_PLUGIN_ROOT/scripts/show-welcome-panel.sh\" --prompt-plaque",
        "timeoutSec": 5
      }
    ]
  }
}
